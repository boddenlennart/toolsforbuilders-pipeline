#!/usr/bin/env python3
"""
Twitter/Bitcoin conversation monitor for @btcmaxistheway
Uses DuckDuckGo search to find relevant Bitcoin discussions on Twitter
Sends daily briefing via Telegram
"""

import json
import re
import sys
import urllib.request
import urllib.parse
from datetime import datetime

# Config
TELEGRAM_BOT_TOKEN = None  # Loaded from openclaw config
TELEGRAM_CHAT_ID = "2046511634"
TWITTER_HANDLE = "btcmaxistheway"
KEYWORDS = [
    "bitcoin self custody",
    "bitcoin hardware wallet",
    "seed phrase security",
    "not your keys not your coins",
    "bitcoin cold storage",
    "ledger trezor bitcoin",
]

def search_ddg(query, max_results=5):
    """Search DuckDuckGo for Twitter discussions"""
    search_query = f"site:twitter.com OR site:x.com {query}"
    encoded = urllib.parse.quote(search_query)
    url = f"https://html.duckduckgo.com/html/?q={encoded}"
    
    req = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (compatible; Skynet-Monitor/1.0)"
    })
    
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
        
        # Extract result snippets
        results = []
        pattern = r'class="result__snippet"[^>]*>(.*?)</a>'
        snippets = re.findall(pattern, html)
        titles_pattern = r'class="result__a"[^>]*>(.*?)</a>'
        titles = re.findall(titles_pattern, html)
        links_pattern = r'class="result__url"[^>]*>(.*?)</span>'
        links = re.findall(links_pattern, html)
        
        for i, (title, snippet) in enumerate(zip(titles[:max_results], snippets[:max_results])):
            clean_title = re.sub(r"<[^>]+>", "", title).strip()
            clean_snippet = re.sub(r"<[^>]+>", "", snippet).strip()
            link = links[i].strip() if i < len(links) else ""
            if clean_title and clean_snippet:
                results.append({
                    "title": clean_title,
                    "snippet": clean_snippet,
                    "url": link
                })
        return results
    except Exception as e:
        return []

def load_openclaw_config():
    """Load telegram token from openclaw config"""
    try:
        with open("/root/.openclaw/openclaw.json") as f:
            config = json.load(f)
        return config.get("channels", {}).get("telegram", {}).get("botToken")
    except:
        return None

def send_telegram(token, chat_id, message):
    """Send message via Telegram"""
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    data = json.dumps({
        "chat_id": chat_id,
        "text": message,
        "parse_mode": "Markdown",
        "disable_web_page_preview": True
    }).encode()
    
    req = urllib.request.Request(url, data=data, headers={
        "Content-Type": "application/json"
    })
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)

def format_report(conversations):
    """Format the daily briefing message"""
    now = datetime.now().strftime("%A, %b %d")
    lines = [
        f"🐦 *Bitcoin Twitter Briefing — {now}*",
        "",
        "Conversations worth joining today:\n"
    ]
    
    count = 0
    for kw, results in conversations.items():
        if not results:
            continue
        lines.append(f"*#{kw.replace(' ', '')}*")
        for r in results[:2]:
            lines.append(f"• {r['snippet'][:120]}...")
            if r['url']:
                lines.append(f"  🔗 {r['url']}")
        lines.append("")
        count += len(results[:2])
    
    if count == 0:
        lines.append("Nothing notable found today. Try manual search.")
    
    lines.append("_Reply to relevant threads with your expertise. Your book link: amazon.com/dp/B0GNZ97Z46_")
    return "\n".join(lines)

def main():
    token = load_openclaw_config()
    if not token:
        print("ERROR: Could not load Telegram token", file=sys.stderr)
        sys.exit(1)
    
    print("Searching for Bitcoin conversations on Twitter...")
    conversations = {}
    
    for keyword in KEYWORDS[:4]:  # Limit to 4 searches
        print(f"  Searching: {keyword}")
        results = search_ddg(keyword)
        if results:
            conversations[keyword] = results
    
    report = format_report(conversations)
    print("Sending Telegram briefing...")
    send_telegram(token, TELEGRAM_CHAT_ID, report)
    print("Done!")

if __name__ == "__main__":
    main()
